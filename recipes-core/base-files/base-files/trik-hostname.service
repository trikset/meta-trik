[Unit]
Description=TRIK hostname from MAC
After=sys-subsystem-net-devices-wlan0.device
Wants=sys-subsystem-net-devices-wlan0.device
Before=network.target avahi-daemon.service sshd.service sshd@.service sshd.socket

[Service]
Type=oneshot
ExecStart=/usr/libexec/trik/trik-hostname.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
