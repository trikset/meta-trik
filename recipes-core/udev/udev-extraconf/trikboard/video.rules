# TRIK camera port aliases.
# The DaVinci VPIF capture driver registers both channels with the same v4l2
# name ("vpif_capture"), so the actual /dev/videoN node is NOT stable (it
# depends on probe order: a USB camera can take /dev/video0 first). The two
# VPIF channels are told apart by the per-v4l2_device "index" (get_index() in
# v4l2-dev.c): the driver registers channel_id 0 first (index 0) and
# channel_id 1 second (index 1). On the board the ports are wired the other
# way around: index 1 is the first port (video1), index 0 is the second (video2).
SUBSYSTEM=="video4linux", ATTR{name}=="vpif_capture", ATTR{index}=="1", SYMLINK+="video1-dev"
SUBSYSTEM=="video4linux", ATTR{name}=="vpif_capture", ATTR{index}=="0", SYMLINK+="video2-dev"

# USB UVC webcam on the dedicated camera port. It is the only video4linux
# device that is not a VPIF capture channel.
SUBSYSTEM=="video4linux", ATTR{name}!="vpif_capture", SYMLINK+="usb-camera-dev"
