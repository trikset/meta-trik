[Unit]
Description=TRIK GUI
After=nrf-fw-update.service trik-wifi-mode@wlan0.service display-manager.service
Wants=display-manager.service

[Service]
Type=simple
Environment=DISPLAY=:0
Environment=QT_QPA_PLATFORM=xcb
Environment=QT_XCB_GL_INTEGRATION=xcb_egl
Environment=QT_OPENGL=es2
ExecStart=/usr/libexec/trik/trikGui.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
