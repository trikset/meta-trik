#!/bin/sh
### BEGIN INIT INFO
# Provides:          mjpg-streamer
# Required-Start:    $remote_fs
# Required-Stop:     $remote_fs
# Short-Description: Start/stop mjpg-streamer for a TRIK camera port
### END INIT INFO
#
# On-demand mjpg-streamer controller used by trikRuntime's Brick::startTranslation /
# stopTranslation. It is NOT registered with sysvinit: the runtime starts and
# stops the streamer explicitly, one instance per camera port, so several
# cameras can stream at the same time (each on its own HTTP port and PID file).
#
# Usage: mjpg-streamer {start|stop|status|restart} <port> [device]
#   port     TRIK camera port name (video1, video2, usb-camera).
#   device   device file for usb-camera (e.g. /dev/video2); ignored for ov7670
#            ports, whose frames come from the DSP JPEG encoder through a FIFO.

PATH=/sbin:/usr/sbin:/bin:/usr/bin

DAEMON=/usr/bin/mjpg_streamer
DAEMON_DIR=/usr/bin
WWW=/usr/share/mjpg-streamer/www
RUNDIR=/var/run/mjpg-streamer

log() {
    echo "mjpg-streamer[${1:-?}]: $2" >&2
}

# Each camera port gets its own HTTP port so concurrent streams never clash.
http_port() {
    case "$1" in
        video1)      echo 8080 ;;
        video2)      echo 8081 ;;
        usb-camera)  echo 8082 ;;
        *)           echo 8080 ;;
    esac
}

pid_file() {
    echo "$RUNDIR/$1.pid"
}

running() {
    [ -f "$1" ] || return 1
    kill -0 "$(cat "$1")" 2>/dev/null
}

do_start() {
    port="$1"
    device="$2"
    pidf="$(pid_file "$port")"
    hport="$(http_port "$port")"
    input=

    mkdir -p "$RUNDIR"

    if running "$pidf"; then
        log "$port" "already running"
        return 0
    fi

    case "$port" in
        usb-camera)
            # UVC webcam: mjpg-streamer opens the device directly.
            input="input_uvc.so -d ${device:-/dev/video2} -r 432x240 -f 30"
            ;;
        *)
            # ov7670: frames come from the DSP JPEG encoder through a per-port
            # FIFO (/run/mjpg-encoder-<port>.out.fifo).
            input="input_fifo.so -n /run/mjpg-encoder-$port.out.fifo"
            ;;
    esac

    export LD_LIBRARY_PATH="$DAEMON_DIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    cd "$DAEMON_DIR" || return 1

    # Run the daemon in the foreground (exec), so the caller's QProcess owns
    # the mjpg_streamer process itself and can waitForFinished() on stop: the
    # camera device is guaranteed to be released only after the process exits.
    echo $$ > "$pidf"
    log "$port" "started on http port $hport"
    exec "$DAEMON" -i "$input" -o "output_http.so -p $hport -w $WWW"
    return 0
}

do_stop() {
    port="$1"
    pidf="$(pid_file "$port")"

    [ -f "$pidf" ] || return 0
    pid="$(cat "$pidf")"
    rm -f "$pidf"
    [ -n "$pid" ] && kill "$pid" 2>/dev/null
    log "$port" "stopped"
    return 0
}

do_status() {
    port="$1"
    pidf="$(pid_file "$port")"

    if running "$pidf"; then
        log "$port" "running (pid $(cat "$pidf"))"
        return 0
    fi
    log "$port" "not running"
    return 3
}

usage() {
    echo "Usage: $0 {start|stop|status|restart} <port> [device]" >&2
    exit 1
}

test -x "$DAEMON" || exit 0
[ $# -ge 2 ] || usage

cmd="$1"
port="$2"
device="${3:-}"

case "$cmd" in
    start)   do_start "$port" "$device" ;;
    stop)    do_stop "$port" ;;
    status)  do_status "$port" ;;
    restart) do_stop "$port"; do_start "$port" "$device" ;;
    *)       usage ;;
esac
